# Copie este arquivo para .env e ajuste o IP para o valor real da máquina
# que roda o backend na sua rede local. Necessário apenas para testar em
# device físico via Wi-Fi — emulador Android e simulador iOS já resolvem
# o host automaticamente via fallback em src/config/env.js, sem precisar
# deste arquivo.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
