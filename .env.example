# ============================================================
# Blog EducaMais — Fase 04 — Variáveis de Ambiente (backend)
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env — contém credenciais reais
# ============================================================

# Banco de dados (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blogdb

# Backend (Express)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blogdb?schema=public

# Obrigatório em qualquer ambiente. Use segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Obrigatório. Separe múltiplas origens exatas por vírgula; wildcard não é aceito.
CORS_ORIGIN=http://localhost:8081
