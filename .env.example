# ============================================================
# Blog EducaMais — Fase 04 — Variáveis de Ambiente (backend)
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env — contém credenciais reais
# ============================================================

# ATENCAO (Windows): salve este arquivo e o .env com fim de linha LF.
# Com CRLF cada valor termina em carriage return dentro do container Linux e
# quebra CORS, hash de senha do seed e validacao de segredos.

# Banco de dados (PostgreSQL)
POSTGRES_USER=postgres
# Obrigatoria. O compose recusa subir sem ela; nao use a senha de exemplo.
POSTGRES_PASSWORD=
POSTGRES_DB=blogdb

# Backend (Express)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blogdb?schema=public

# Obrigatório em qualquer ambiente. Use segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=

# Obrigatório e distinto do JWT_SECRET. Use segredo aleatório com pelo menos 32 caracteres.
RATE_LIMIT_SECRET=
JWT_EXPIRES_IN=8h

# Obrigatório. Separe múltiplas origens exatas por vírgula; wildcard não é aceito.
CORS_ORIGIN=http://localhost:8081

# Numero de proxies confiaveis a frente da API (1 no compose, por causa do
# gateway do Docker). Sem isso o limite de tentativas de login vira global.
TRUSTED_PROXY_HOPS=1

# Opcional: custo do bcrypt, inteiro entre 10 e 15 (padrao 10).
# BCRYPT_SALT_ROUNDS=10

# Bootstrap do primeiro professor via seed (`npx prisma db seed`).
# Obrigatórias SOMENTE ao executar o seed; nunca commitá-las preenchidas.
# Exigidas pelo script backend/prisma/seed.js — falha limpa sem elas.
INITIAL_TEACHER_NAME=
INITIAL_TEACHER_EMAIL=
INITIAL_TEACHER_PASSWORD=
